scope: {{ patroni_scope }}
namespace: {{ patroni_namespace }}
name: {{ patroni_name }}

restapi:
  listen: {{ ansible_host }}:{{ patroni_api_port }}
  connect_address: {{ ansible_host }}:{{ patroni_api_port }}

etcd3:
  hosts: "{{ etcd_cluster_members.values() | join(',') | regex_replace(':2380', ':2379') }}"

bootstrap:
  dcs:
    ttl: {{ patroni_ttl }}
    loop_wait: {{ patroni_loop_wait }}
    retry_timeout: {{ patroni_retry_timeout }}

    maximum_lag_on_failover: {{ patroni_maximum_lag_on_failover }}
    check_timeline: true

    postgresql:
      use_pg_rewind: true
      use_slots: true

  initdb:
    - encoding: UTF8
    - data-checksums

  pg_hba:
    - local   all             all                                   peer
    - host    all             all             127.0.0.1/32         scram-sha-256
    - host    all             all             10.10.10.0/24        scram-sha-256
    - host    replication    {{ postgres_replication_user }} 10.10.10.0/24 scram-sha-256

postgresql:
  listen: 0.0.0.0:{{ postgresql_port }}
  connect_address: {{ ansible_host }}:{{ postgresql_port }}

  data_dir: {{ postgresql_data_dir }}

  bin_dir: /usr/lib/postgresql/{{ postgresql_version }}/bin

  authentication:
    superuser:
      username: {{ postgres_superuser }}
      password: {{ vault_postgres_password }}

    replication:
      username: {{ postgres_replication_user }}
      password: {{ vault_replication_password }}

  parameters:
    max_connections: 200

    shared_buffers: 512MB
    effective_cache_size: 1536MB
    work_mem: 8MB
    maintenance_work_mem: 128MB

    wal_level: replica
    wal_compression: on

    max_wal_senders: 10
    max_replication_slots: 10

    hot_standby: on
    wal_log_hints: on

    password_encryption: scram-sha-256

tags:
  nofailover: false
  noloadbalance: false
  clonefrom: false
  nosync: false